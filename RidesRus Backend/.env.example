# ===========================================================
#  RidesRus Backend — Environment Variables Template
#  Copy this file to .env and fill in all values
# ===========================================================

# ─── DATABASE ───────────────────────────────────────────────
# Your PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/ridesrus"

# ─── REDIS ──────────────────────────────────────────────────
# Your Redis connection string (local or cloud like Upstash)
REDIS_URL="redis://localhost:6379"

# ─── JWT AUTH ───────────────────────────────────────────────
# A long random secret string (use: openssl rand -base64 64)
JWT_SECRET="replace-with-a-long-random-secret-string"
JWT_EXPIRY="7d"

# ─── FLUTTERWAVE ────────────────────────────────────────────
# Get these from: https://dashboard.flutterwave.com > Settings > API Keys
FLW_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx-X"
FLW_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx-X"
FLW_ENCRYPTION_KEY="xxxxxxxxxxxxxxxxxxxx"
# The URL Flutterwave redirects to after payment (your API callback)
FLW_REDIRECT_URL="http://localhost:3000/payment/verify"
# The secret to validate incoming Flutterwave webhooks
FLW_WEBHOOK_SECRET="your-flutterwave-webhook-secret"

# ─── MAPBOX ─────────────────────────────────────────────────
# Get from: https://account.mapbox.com > Access Tokens
MAPBOX_SECRET_TOKEN="sk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ..."

# ─── FIREBASE (Push Notifications) ──────────────────────────
# Get from: https://console.firebase.google.com > Project Settings > Service Accounts
# Download the service account JSON and paste values below
FIREBASE_PROJECT_ID="ridesrus-xxxx"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@ridesrus-xxxx.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── APP CONFIG ──────────────────────────────────────────────
PORT=3000
NODE_ENV="development"
