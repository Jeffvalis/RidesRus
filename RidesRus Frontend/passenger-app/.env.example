# ===========================================================
#  RidesRus Passenger App — Environment Variables Template
#  Copy this file to .env and fill in all values
#  In Expo, all public env vars must be prefixed EXPO_PUBLIC_
# ===========================================================

# ─── BACKEND ─────────────────────────────────────────────────
# URL of the running NestJS backend
EXPO_PUBLIC_API_URL="http://localhost:3000"

# ─── MAPBOX ─────────────────────────────────────────────────
# Get from: https://account.mapbox.com > Access Tokens
# Use a PUBLIC token (starts with pk.) for mobile apps
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN="pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ..."
