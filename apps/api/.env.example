# ── Core ─────────────────────────────────────────────
PORT=3005
# Local embedded Postgres (npm run db:start). Use Neon/Supabase/RDS in production.
DATABASE_URL=postgresql://ridesrus:ridesrus@localhost:5433/ridesrus
# Generate with: openssl rand -hex 32   (must be ≥ 32 chars)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Signs rotating boarding QR codes. Separate from JWT_SECRET so it can be rotated independently.
QR_SECRET=change-me-to-another-long-random-string-32-chars
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082
# Public URL of this API (used for sandbox checkout redirects).
PUBLIC_API_URL=http://localhost:3005

# ── Demo mode ────────────────────────────────────────
# true = autopilot buses + simulated riders, guest sign-in, sandbox payments, demo QR helper.
DEMO_MODE=true
# Demo buses drive N× faster than real Lekki traffic (ETAs scale too).
DEMO_SPEEDUP=3

# ── Payments ─────────────────────────────────────────
# sandbox | flutterwave
PAYMENTS_PROVIDER=sandbox
FLW_SECRET_KEY=
# The "secret hash" set in the Flutterwave dashboard; sent back in the verif-hash header.
FLW_WEBHOOK_HASH=
# Where Flutterwave returns the passenger after checkout (an app deep link or web URL).
FLW_REDIRECT_URL=ridesrus://wallet
