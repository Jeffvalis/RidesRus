{
  "name": "@ridesrus/api",
  "version": "3.0.0",
  "private": true,
  "description": "RidesRus API: REST + Socket.IO, ledger, boarding, fleet state and demo autopilot.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:start": "tsx scripts/local-postgres.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "prisma migrate deploy && tsx scripts/seed.ts",
    "test": "jest --runInBand",
    "postinstall": "prisma generate",
    "db:audit": "tsx scripts/check-ledger.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@ridesrus/core": "3.0.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "18.4.0-beta.17",
    "jest": "^30.0.0",
    "prisma": "7.10.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "(src|test)/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/test/global-setup.mjs",
    "globalTeardown": "<rootDir>/test/global-teardown.mjs",
    "testTimeout": 30000
  }
}
